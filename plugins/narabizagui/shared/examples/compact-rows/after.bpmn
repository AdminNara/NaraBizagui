<bpmn:collaboration id="Collaboration_Generic"><bpmn:participant id="Pool_Generic" name="Gestión de solicitudes" processRef="Process_Generic"><bpmn:documentation>Proceso didáctico ficticio; sin fuentes de clientes.</bpmn:documentation></bpmn:participant></bpmn:collaboration>
<bpmn:process id="Process_Generic" isExecutable="false"><bpmn:laneSet id="LaneSet_Generic">
<bpmn:lane id="Lane_1" name="Recepción"><bpmn:flowNodeRef>Start_Generic</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_2" name="Análisis"><bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_3" name="Registro"><bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Generic</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start_Generic" name="Inicio">
<bpmn:outgoing>Flow_1</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:userTask id="Task_1" name="Recibir solicitud"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_1</bpmn:incoming>
<bpmn:outgoing>Flow_2</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_1"><bpmn:dataOutput id="Output_Data_1" /><bpmn:inputSet id="InputSet_Task_1"></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_1"><bpmn:dataOutputRefs>Output_Data_1</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataOutputAssociation id="Data_1"><bpmn:sourceRef>Output_Data_1</bpmn:sourceRef><bpmn:targetRef>Doc_1</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:userTask>
<bpmn:userTask id="Task_2" name="Revisar datos"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_2</bpmn:incoming>
<bpmn:outgoing>Flow_3</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_2"><bpmn:dataInput id="Input_Data_2" /><bpmn:inputSet id="InputSet_Task_2"><bpmn:dataInputRefs>Input_Data_2</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_2"></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataInputAssociation id="Data_2"><bpmn:sourceRef>Doc_1</bpmn:sourceRef><bpmn:targetRef>Input_Data_2</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:userTask>
<bpmn:userTask id="Task_3" name="Consultar catálogo"><bpmn:documentation>Consulta de solo lectura; no persiste datos.</bpmn:documentation>
<bpmn:incoming>Flow_3</bpmn:incoming>
<bpmn:outgoing>Flow_4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="Task_4" name="Seleccionar alternativa"><bpmn:documentation>La alternativa seleccionada es un dato temporal.</bpmn:documentation>
<bpmn:incoming>Flow_4</bpmn:incoming>
<bpmn:outgoing>Flow_5</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_4"><bpmn:dataOutput id="Output_Data_3" /><bpmn:inputSet id="InputSet_Task_4"></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_4"><bpmn:dataOutputRefs>Output_Data_3</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataOutputAssociation id="Data_3"><bpmn:sourceRef>Output_Data_3</bpmn:sourceRef><bpmn:targetRef>Doc_2</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:userTask>
<bpmn:userTask id="Task_5" name="Preparar registro"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_5</bpmn:incoming>
<bpmn:outgoing>Flow_6</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="Task_6" name="Registrar resultado"><bpmn:documentation>Persiste el registro en el sistema de ejemplo.</bpmn:documentation>
<bpmn:incoming>Flow_6</bpmn:incoming>
<bpmn:outgoing>Flow_7</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_6"><bpmn:dataOutput id="Output_Data_4" /><bpmn:inputSet id="InputSet_Task_6"></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_6"><bpmn:dataOutputRefs>Output_Data_4</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataOutputAssociation id="Data_4"><bpmn:sourceRef>Output_Data_4</bpmn:sourceRef><bpmn:targetRef>Doc_3</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:userTask>
<bpmn:userTask id="Task_7" name="Verificar registro"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_7</bpmn:incoming>
<bpmn:outgoing>Flow_8</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_7"><bpmn:dataInput id="Input_Data_5" /><bpmn:inputSet id="InputSet_Task_7"><bpmn:dataInputRefs>Input_Data_5</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_7"></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataInputAssociation id="Data_5"><bpmn:sourceRef>Doc_3</bpmn:sourceRef><bpmn:targetRef>Input_Data_5</bpmn:targetRef></bpmn:dataInputAssociation>
</bpmn:userTask>
<bpmn:userTask id="Task_8" name="Notificar resultado"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_8</bpmn:incoming>
<bpmn:outgoing>Flow_9</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="Task_9" name="Archivar constancia"><bpmn:documentation>Actividad ficticia para evaluar composición.</bpmn:documentation>
<bpmn:incoming>Flow_9</bpmn:incoming>
<bpmn:outgoing>Flow_10</bpmn:outgoing>
<bpmn:ioSpecification id="IO_Task_9"><bpmn:dataOutput id="Output_Data_6" /><bpmn:inputSet id="InputSet_Task_9"></bpmn:inputSet><bpmn:outputSet id="OutputSet_Task_9"><bpmn:dataOutputRefs>Output_Data_6</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>
<bpmn:dataOutputAssociation id="Data_6"><bpmn:sourceRef>Output_Data_6</bpmn:sourceRef><bpmn:targetRef>Doc_4</bpmn:targetRef></bpmn:dataOutputAssociation>
</bpmn:userTask>
<bpmn:endEvent id="End_Generic" name="Fin">
<bpmn:incoming>Flow_10</bpmn:incoming>
</bpmn:endEvent>
<bpmn:dataObject id="Object_Doc_1" /><bpmn:dataObjectReference id="Doc_1" name="Solicitud" dataObjectRef="Object_Doc_1"><bpmn:documentation>Documento de entrada recibido.</bpmn:documentation></bpmn:dataObjectReference>
<bpmn:dataObject id="Object_Doc_2" /><bpmn:dataObjectReference id="Doc_2" name="Selección temporal" dataObjectRef="Object_Doc_2"><bpmn:documentation>Dato de trabajo; la selección no crea un archivo ni guarda un registro.</bpmn:documentation></bpmn:dataObjectReference>
<bpmn:dataObject id="Object_Doc_3" /><bpmn:dataObjectReference id="Doc_3" name="Registro guardado" dataObjectRef="Object_Doc_3"><bpmn:documentation>Registro persistido únicamente por Registrar resultado.</bpmn:documentation></bpmn:dataObjectReference>
<bpmn:dataObject id="Object_Doc_4" /><bpmn:dataObjectReference id="Doc_4" name="Constancia" dataObjectRef="Object_Doc_4"><bpmn:documentation>Constancia de archivo del ejemplo.</bpmn:documentation></bpmn:dataObjectReference>
